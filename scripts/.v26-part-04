ey of LEGACY_STORAGE_KEYS) localStorage.removeItem(key);
    } finally {
      refresh();
    }
    return Promise.resolve();
  }

  const api = Object.freeze({
    release: RELEASE,
    groupsUrl: `${DATA_ROOT}groups.json`,
    mapUrl: MANIFEST_URL,
    storageKey: STORAGE_KEY,
    legacyStorageKeys: LEGACY_STORAGE_KEYS,
    hasLegacyOverrides,
    loadManifest,
    loadGroups,
    loadServerMap,
    readLocalPayload,
    importPayload,
    clearLocalOverrides,
    exactMapFrom,
    compose,
    refresh
  });

  global.MagiToolsV7 = Object.freeze({ ...Tools, loadLocalizationV7: loadMergedLocalization });
  global.__STORY_TITLE_RUNTIME_V1__ = api;
  document.documentElement.dataset.storyTitleRuntimeV2 = RELEASE;
})(window);
'''


CI_WORKFLOW = r'''name: Repository CI
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Validate canonical data and active JavaScript
        run: |
          set -euo pipefail
          python scripts/validate-site.py
          node --check public/myfile/story-title-runtime-v2.js
          node --check public/myfile/story-title-editor-v2.js
          node --check public/myfile/story-app-v7.js
'''


UPDATE_WORKFLOW = r'''name: Update authoritative titles
on:
  workflow_dispatch:
  schedule:
    - cron: "23 3 * * 1"
permissions:
  contents: write
concurrency:
  group: authoritative-title-update
  cancel-in-progress: false
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/checkout@v4
        with:
          repository: HiiragiNemu/magireco-cn-patch
          path: _sources/magireco-cn-patch
          fetch-depth: 1
          sparse-checkout-cone-mode: false
          sparse-checkout: magica/js/libs
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Rebuild authoritative titles
        run: |
          set -euo pipefail
          release="v26-authoritative-cn-$(date -u +%Y%m%d)"
          python scripts/update-authoritative-titles.py \
            --repo-root . \
            --libs-dir _sources/magireco-cn-patch/magica/js/libs
          python scripts/build-title-data.py \
            --repo-root . \
            --input public/data/story-title-groups-v1.json \
            --release "$release"
          rm -rf _sources public/v23-build-marker.json
          python scripts/validate-site.py
      - name: Commit verified update
        run: |
          set -euo pipefail
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add -A
          if git diff --cached --quiet; then
            echo "No authoritative title changes."
            exit 0
          fi
          git commit -m "Update authoritative Chinese title data"
          git push origin HEAD:main
'''


PRODUCTION_WORKFLOW = r'''name: Production verification
on:
  push:
    branches: [main]
    paths:
      - "public/**"
      - "scripts/validate-site.py"
      - ".github/workflows/production-verify.yml"
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: production-verification
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Wait for and verify Cloudflare Pages
        run: |
          set -euo pipefail
          python - <<'PY'
          import json, time, urllib.request
          from pathlib import Path
          local = json.loads(Path("public/data/titles/manifest.json").read_text(encoding="utf-8"))
          base = "https://magireco-call-search-cn.pages.dev/"
          def get(path):
              req = urllib.request.Request(base + path, headers={"Cache-Control":"no-cache, no-store"})
              with urllib.request.urlopen(req, timeout=30) as response:
                  return response.read()
          for attempt in range(120):
              try:
                  remote = json.loads(get(f"data/titles/manifest.json?v={time.time_ns()}"))
                  if remote.get("release") == local.get("release"):
                      break
              except Exception:
                  pass
              time.sleep(10)
          else:
              raise SystemExit("Timed out waiting for production")
          exact = {}
          for entry in remote["shards"]:
              shard = json.loads(get(f"data/titles/{entry['file']}?v={time.time_ns()}"))
              exact[shard["category"]] = shard["titles"]
          assert remote["groupCount"] == 2166
          assert remote["childTitleCount"] == remote["mappedTitleCount"] == 5826
          assert remote["kanaInChineseDisplayFields"] == 0
          assert exact["scene0"]["サイドストーリー Film.0 1 (紫)"] == "支线故事 Film.0 1 （紫色）"
          assert exact["イベント"]["トリック☆トラブル☆学園祭 BADEND1話"] == "诡计☆骚乱☆学园祭 坏结局 第1话"
          assert exact["メモリア"]["No.888 夢を追う妹"] == "No.888 追梦的妹妹"
          runtime = get(f"myfile/story-title-runtime-v2.js?v={time.time_ns()}").decode()
          assert "story-title-runtime-v26-20260821" in runtime
          assert "DecompressionStream" not in runtime
          index = get(f"?v={time.time_ns()}").decode()
          assert "魔法纪录·Magia Exedra 魔法少女称呼搜索</div>" not in index
          proof = {"state":"pass","release":remote["release"],"groupCount":2166,"childTitleCount":5826,"mappedTitleCount":5826,"kanaInChineseDisplayFields":0}
          Path("/tmp/production-proof.json").write_text(json.dumps(proof, ensure_ascii=False, indent=2) + "\n")
          print(json.dumps(proof, ensure_ascii=False, indent=2))
          PY
      - uses: