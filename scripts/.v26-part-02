  const STORAGE_KEY = 'magireco-story-title-overrides-v26';
  const LEGACY_STORAGE_KEYS = [
    'magireco-story-title-overrides-v1',
    'magireco-story-title-overrides-v25'
  ];
  const Tools = global.MagiToolsV7;
  if (!Tools?.loadLocalizationV7) {
    console.error('V26 标题运行时未找到 MagiToolsV7。');
    return;
  }

  const originalLoad = Tools.loadLocalizationV7.bind(Tools);
  let manifestPromise = null;
  let groupsPromise = null;
  let serverMapPromise = null;
  let mergedPromise = null;

  async function fetchRequired(url) {
    const response = await fetch(url, { cache: 'no-store' });
    if (!response.ok) throw new Error(`${url}：HTTP ${response.status}`);
    return response.json();
  }

  function loadManifest() {
    if (!manifestPromise) {
      manifestPromise = fetchRequired(MANIFEST_URL).then((manifest) => {
        if (!manifest || manifest.release !== DATA_RELEASE ||
            manifest.groupCount !== 2166 || manifest.childTitleCount !== 5826 ||
            !Array.isArray(manifest.shards)) {
          throw new Error('V26 标题清单格式或版本无效。');
        }
        return manifest;
      });
    }
    return manifestPromise;
  }

