ild.get("localized_suffix")))
            if KANA_RE.search(full):
                kana_hits.append((category, source_title, "full", full))
            if source_title:
                mapping[source_title] = full
                child_count += 1
        parent_rows.append({
            "groupId": group.get("group_id"),
            "category": category,
            "categoryLabel": group.get("category_label") or category,
            "sourceTitle": source_base,
            "displayTitle": display,
            "childCount": len(children),
            "sourceSha256": group.get("source_sha256"),
        })
    if kana_hits:
        raise RuntimeError(f"{len(kana_hits)} Chinese display fields still contain kana: {kana_hits[:20]}")
    if len(groups) != 2166 or child_count != 5826:
        raise RuntimeError(f"Unexpected title counts: groups={len(groups)} children={child_count}")

    generated_at = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
    groups_data.update({"schemaVersion": 1, "version": 26, "release": release, "generatedAt": generated_at})
    groups_data["summary"] = {
        **(groups_data.get("summary") or {}),
        "groupCount": len(groups),
        "childTitleCount": child_count,
        "approvedGroupCount": len(groups),
        "missingLocalizationCount": 0,
        "missingLocalizationSample": [],
        "kanaInChineseTranslationCount": 0,
    }

    data_root = root / "public/data/titles"
    if data_root.exists():
        shutil.rmtree(data_root)
    (data_root / "shards").mkdir(parents=True, exist_ok=True)

    groups_payload = {
        "schemaVersion": 1,
        "version": 26,
        "release": release,
        "generatedAt": generated_at,
        "summary": groups_data["summary"],
        "groups": groups,
    }
    groups_sha = write_json(data_root / "groups.json", groups_payload)
    parents_sha = write_json(data_root / "parents.json", {
        "schemaVersion": 1,
        "release": release,
        "generatedAt": generated_at,
        "count": len(parent_rows),
        "parents": parent_rows,
    })

    shard_entries = []
    for category, mapping in title_by_category.items():
        digest = hashlib.sha1(category.encode("utf-8")).hexdigest()[:12]
        filename = f"shards/category-{digest}.json"
        payload = {
            "schemaVersion": 1,
            "release": release,
            "category": category,
            "count": len(mapping),
            "titles": dict(sorted(mapping.items(), key=lambda item: natural_key(item[0]))),
        }
        sha = write_json(data_root / filename, payload)
        shard_entries.append({
            "category": category,
            "categoryLabel": next((r["categoryLabel"] for r in parent_rows if r["category"] == category), category),
            "file": filename,
            "count": len(mapping),
            "sha256": sha,
        })

    source_priority = [
        "magireco-cn-patch/magica/js/libs",
        "existing human/audited translations",
        "MagiReader",
        "magireco-wiki-data",
        "manual fallback",
    ]
    manifest = {
        "schemaVersion": 1,
        "release": release,
        "generatedAt": generated_at,
        "groupCount": len(groups),
        "childTitleCount": child_count,
        "mappedTitleCount": sum(item["count"] for item in shard_entries),
        "kanaInChineseDisplayFields": 0,
        "groups": {"file": "groups.json", "sha256": groups_sha},
        "parents": {"file": "parents.json", "sha256": parents_sha},
        "shards": shard_entries,
        "sourcePriority": source_priority,
    }
    manifest_sha = write_json(data_root / "manifest.json", manifest)
    write_json(data_root / "provenance.json", {
        "schemaVersion": 1,
        "release": release,
        "generatedAt": generated_at,
        "sourcePriority": source_priority,
        "baselineRelease": "v25-live-cn-20260821",
        "baselineProductionProof": "GitHub Actions run 32396157906",
        "manifestSha256": manifest_sha,
        "notes": [
            "Canonical JSON replaces the V25 browser-side base64/gzip delta transport.",
            "Compatibility outputs remain available at the historical file paths.",
        ],
    })

    compatibility_map = {
        "schemaVersion": 1,
        "version": 26,
        "release": release,
        "generatedAt": generated_at,
        "summary": {
            "groupCount": len(groups),
            "childTitleCount": child_count,
            "mappedTitleCount": sum(len(m) for m in title_by_category.values()),
            "kanaInChineseTranslationCount": 0,
        },
        "titleByCategory": title_by_category,
    }
    write_json(root / "public/data/story-title-groups-v1.json", groups_payload)
    write_json(root / "public/data/story-title-map.generated.json", compatibility_map)
    write_json(root / "public/downloads/story-title-groups.json", groups_payload)

    csv_path = root / "public/downloads/story-title-groups.csv"
    csv_path.parent.mkdir(parents=True, exist_ok=True)
    with csv_path.open("w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(["group_id", "分类", "日文母故事名", "网站显示文本", "子剧情数量", "source_sha256"])
        for row in parent_rows:
            writer.writerow([row["groupId"], row["category"], row["sourceTitle"], row["displayTitle"], row["childCount"], row["sourceSha256"]])
    shutil.copy2(csv_path, data_root / "groups.csv")

    write_json(root / "public/version.json", {
        "release": release,
        "generatedAt": generated_at,
        "runtime": "story-title-runtime-v26-20260821",
        "manifest": "data/titles/manifest.json",
        "groupCount": len(groups),
        "childTitleCount": child_count,
        "mappedTitleCount": child_count,
        "kanaInChineseDisplayFields": 0,
    })
    if remove_delta:
        for part in (root / "public/data").glob("v25-title-delta.part-*.txt"):
            part