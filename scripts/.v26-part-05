def patch_pages_and_runtime() -> None:
    write_text(ROOT / "public/myfile/story-title-runtime-v2.js", RUNTIME_JS)
    for rel in ("public/story-title-editor.html", "public/story.html"):
        path = ROOT / rel
        text = path.read_text(encoding="utf-8")
        text = re.sub(r'\s+data-build="[^"]*"', "", text)
        text = text.replace("<body ", f'<body data-build="{RELEASE}" ', 1)
        text = re.sub(r'story-title-runtime-v2\.js\?v=[^"<]+', "story-title-runtime-v2.js?v=20260821-26", text)
        if rel.endswith("story-title-editor.html"):
            text = text.replace(">清除本地修改</button>", ">恢复服务器最新版</button>")
            text = text.replace('href="./downloads/story-title-groups.csv"', 'href="./data/titles/groups.csv"')
            text = text.replace('href="./downloads/story-title-groups.json"', 'href="./data/titles/groups.json"')
        write_text(path, text)

    editor = ROOT / "public/myfile/story-title-editor-v2.js"
    text = editor.read_text(encoding="utf-8")
    text = re.sub(r"const RELEASE = '[^']+';", "const RELEASE = 'story-title-dense-editor-v26-20260821';", text, count=1)
    text = text.replace(
        "setStatus('已清除本浏览器中的标题变更，恢复网站当前显示文本。', 'success');",
        "setStatus('已清除本版本及旧版本的浏览器标题覆盖，恢复服务器最新版。', 'success');"
    )
    old = "setStatus('完整清单已加载：一行一个母故事，第二列就是网站当前显示文本。', 'success');"
    new = '''const legacy = Boolean(Runtime.hasLegacyOverrides?.());
      setStatus(
        legacy
          ? '完整清单已加载；检测到旧版本本地修改，已隔离且不会覆盖服务器译名。点击“恢复服务器最新版”可彻底清除。'
          : '完整清单已加载：一行一个母故事，第二列就是服务器当前显示文本。',
        legacy ? 'info' : 'success'
      );'''
    if old not in text:
        raise RuntimeError("Could not patch editor status")
    text = text.replace(old, new)
    write_text(editor, text)

    index = ROOT / "public/index.html"
    text = index.read_text(encoding="utf-8")
    text = re.sub(
        r'\s*<div class="navtext-container">\s*<div class="navtext">魔法纪录·Magia Exedra 魔法少女称呼搜索</div>\s*</div>\s*',
        "\n", text, count=1,
    )
    text = re.sub(r'href="./myfile/hamburgerMenu\.css(?:\?[^\"]*)?"', 'href="./myfile/hamburgerMenu.css?v=20260821-26"', text)
    if "hamburger-menu-v23.js" not in text:
        text = text.replace("</body>", '\n<script src="./myfile/hamburger-menu-v23.js?v=20260821-26" defer></script>\n</body>', 1)
    write_text(index, text)


def cleanup_repository() -> None:
    for path in (ROOT / ".automation", ROOT / "node_modules", ROOT / "NEW"):
        if path.exists():
            shutil.rmtree(path)
    for pattern in (".deploy-*", ".v22-*", ".v25-production-verify-trigger", ".v26-convergence-trigger"):
        for path in ROOT.glob(pattern):
            if path.is_file():
                path.unlink()

    workflows = ROOT / ".github/workflows"
    if workflows.exists():
        shutil.rmtree(workflows)
    workflows.mkdir(parents=True, exist_ok=True)
    write_text(workflows / "ci.yml", CI_WORKFLOW)
    write_text(workflows / "update-authoritative-titles.yml", UPDATE_WORKFLOW)
    write_text(workflows / "production-verify.yml", PRODUCTION_WORKFLOW)

    obsolete_scripts = [
        "build-authoritative-localization-v22.py", "finalize-v22.py", "finalize-v23.py",
        "prepare-v22-offline-fallback.py", "prepare-v24.py",
        "run-v22-authoritative-safe.py", "run-v22-authoritative-safe-v2.py",
        "v22-authority-extension.py", "v22-site-assurance.py",
        "build-story-titles-v10.py", "build-story-title-groups-v1.py",
        "improve-title-sources-v10.py", "audit-translations-v5.py", "v26-converge.py",
    ]
    for name in obsolete_scripts:
        path = ROOT / "scripts" / name
        if path.exists():
            path.unlink()
    for path in (ROOT / "tests").glob("v22-*"):
        path.unlink()

    for path in (
        ROOT / "public/__acceptance.html",
        ROOT / "public/json_open_old.html",
        ROOT / "public/oldfile",
        ROOT / "public/v23-build-marker.json",
        ROOT / "public/v24-local-validation.j